PORT=5000
GROQ_API_KEY=replace_with_your_server_key
GROQ_TEXT_MODEL=openai/gpt-oss-20b
# Select a currently supported image-capable model available to your Groq account.
# Photo scanning is disabled until this is configured. Text entry still works.
GROQ_VISION_MODEL=
# Legacy password routes are disabled by default; generation only accepts Puter identity.
ENABLE_LEGACY_AUTH=false
# If enabling legacy routes, use a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret
# Required for shared generation quotas; history also uses this database.
MONGODB_URI=
# Fixed-window limits count admitted attempts, including failed provider calls.
GENERATION_USER_MINUTE_LIMIT=5
GENERATION_USER_DAY_LIMIT=20
GENERATION_GLOBAL_DAY_LIMIT=200

# Required for source-backed nutrition lookups; keep this key on the server.
USDA_FDC_API_KEY=
# Operators authorized to see anonymized aggregate measurements (puter:<uuid>, comma separated).
MISE_ADMIN_PUTER_IDS=
# Optional estimates per million tokens. Populate current provider rates; absent models stay unpriced.
GENERATION_MODEL_RATES_JSON={}
# Raw request/recipe history is off by default. Enabling it stores recipe text in MongoDB.
SAVE_RECIPE_HISTORY=false
# Optional release checks: an HTTPS deployed test copy of Mise, separate from production.
MISE_STAGING_URL=
# Two real test accounts; never commit credentials. Live generation is quota-counted and billable.
PUTER_TEST_TOKEN_A=
PUTER_TEST_TOKEN_B=
MISE_RUN_LIVE_GENERATION=false
# Dedicated database for the live atomic quota test (never the production database).
MONGO_QUOTA_TEST_URI=
